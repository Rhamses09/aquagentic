# Aquagentic Environment Variables Example
# Copy this file to .env for local development if needed.
# NOTE: In production/desktop builds, keys are stored in the OS Native Credential Manager.

# GitHub Sync (Fine-Grained PAT with only 'Gists: Read & Write' permission)
VITE_GITHUB_SYNC_TOKEN=

# AI Model Provider Keys (BYOK - Optional fallback for web/dev mode)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
